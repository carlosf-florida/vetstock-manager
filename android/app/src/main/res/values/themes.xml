<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Tema" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/azul</item>
        <item name="colorPrimaryDark">@color/azul</item>
        <item name="colorAccent">@color/verde</item>
        <item name="android:windowBackground">@color/fondo</item>
    </style>
    <style name="Tema.SinBarra" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/azul</item>
        <item name="colorAccent">@color/verde</item>
        <item name="android:windowBackground">@color/fondo</item>
    </style>
    <style name="Tarjeta">
        <item name="android:background">@drawable/tarjeta</item>
        <item name="android:padding">14dp</item>
    </style>
    <style name="Titulo">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/azul</item>
    </style>
    <style name="Suave">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/texto_suave</item>
    </style>
    <style name="Texto">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/texto</item>
    </style>
    <style name="BotonPrincipal" parent="Widget.AppCompat.Button.Colored" />
    <style name="BotonSecundario" parent="Widget.AppCompat.Button" />
</resources>
