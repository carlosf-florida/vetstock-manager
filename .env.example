# Variables de entorno de EJEMPLO para VetStock Manager.
# Copia este archivo como ".env" (no se sube a Git) y cambia los valores.
# docker compose lee ".env" automáticamente. Para arrancar sin Docker, define
# las variables en PowerShell antes de lanzar el backend, por ejemplo:
#   $env:DB_PASSWORD = "mi-clave"
# Si no defines nada se usan los valores de demostración de application.properties.

# --- Base de datos MySQL ---
DB_URL=jdbc:mysql://localhost:3306/vetstock?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Europe/Madrid
DB_USER=root
DB_PASSWORD=cambia-esta-clave

# --- Pagos (adaptador de DEMOSTRACIÓN, no cobra) ---
# Clave con la que el "proveedor" firma (HMAC-SHA256) las notificaciones del webhook
PAGOS_SECRETO_WEBHOOK=genera-una-clave-larga-y-aleatoria
# false desactiva la pasarela simulada (obligatorio en un entorno real)
PAGOS_SIMULADO_ACTIVO=true
# Minutos tras los que un pago PENDIENTE se da por abandonado
PAGOS_MINUTOS_SESION=60

# --- Reservas de stock ---
# Horas sin pago confirmado tras las que un pedido enviado a firma se cancela
RESERVAS_HORAS_CADUCIDAD=72

# --- Integración Odoo (opcional) ---
ODOO_MODO=SIMULADO
ODOO_URL=http://localhost:8069
ODOO_DB=vetstock_erp
ODOO_USUARIO=admin
ODOO_CLAVE=cambia-esta-clave

# --- Frontend (servidor de desarrollo Vite) ---
BACKEND_URL=http://localhost:8080
