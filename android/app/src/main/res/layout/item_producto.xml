<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/Tarjeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:orientation="vertical" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground">
    <TextView android:id="@+id/nombre" style="@style/Texto" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" />
    <TextView android:id="@+id/detalle" style="@style/Suave" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
        <TextView android:id="@+id/precio" style="@style/Texto" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textStyle="bold" />
        <TextView android:id="@+id/stock" style="@style/Suave" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
